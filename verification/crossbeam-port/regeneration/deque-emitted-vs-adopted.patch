+internal class Buffer<T : Any>(
+    val cap: Int,
+) {
+    private val slots = Array(cap) { AtomicReference<Entry<T>?>(null) }
+
+    init {
+        require(cap > 0 && cap and (cap - 1) == 0)
+    }
+
+    private fun at(index: Long): AtomicReference<Entry<T>?> = slots[(index and (cap - 1).toLong()).toInt()]
+
+    // A speculative reader may lose the front-index CAS and must not use the value in that case.
+    fun read(index: Long): Entry<T>? = at(index).load()
+
+    fun write(index: Long, task: Entry<T>?) {
+        at(index).store(task)
+    }
+
+    // Drop only our consumed reference, never a newer task that has wrapped into the same slot.
+    fun release(index: Long, task: Entry<T>?) {
+        at(index).compareAndSet(task, null)
     }
