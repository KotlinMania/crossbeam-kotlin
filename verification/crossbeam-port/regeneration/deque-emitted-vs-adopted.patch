+/**
+ * Possible outcomes of a steal operation on non-null tasks. Results can be chained with [orElse], or combined
+ * using [fromIter], which stops at the first success and remembers any retry.
+ *
+ * ```kotlin
+ * check(Steal.fromIter(listOf(Steal.Empty, Steal.Retry, Steal.Empty)) == Steal.Retry)
+ * check(Steal.fromIter(listOf(Steal.Retry, Steal.Success(1), Steal.Empty)) == Steal.Success(1))
+ * val empty: Steal<Int> = Steal.Empty
+ * check(empty.orElse { Steal.Success(1) } == Steal.Success(1))
+ * ```
+ */
+public sealed class Steal<out T : Any> {
+    /** The queue was empty at the time of stealing. */
+    public data object Empty : Steal<Nothing>()
+
+    /** At least one task was successfully stolen. */
+    public data class Success<T : Any>(
+        public val value: T,
+    ) : Steal<T>() {
+        override fun toString(): String = "Success(..)"
+    }
+
+    /** The steal operation needs to be retried. */
+    public data object Retry : Steal<Nothing>()
+
+    /**
+     * Returns true if the queue was empty at the time of stealing.
+     *
+     * ```kotlin
+     * check(!Steal.Success(7).isEmpty())
+     * check(!Steal.Retry.isEmpty())
+     * check(Steal.Empty.isEmpty())
+     * ```
+     */
+    public fun isEmpty(): Boolean = this === Empty
+
+    /**
+     * Returns true if at least one task was stolen.
+     *
+     * ```kotlin
+     * check(!Steal.Empty.isSuccess())
+     * check(!Steal.Retry.isSuccess())
+     * check(Steal.Success(7).isSuccess())
+     * ```
+     */
+    public fun isSuccess(): Boolean = this is Success
+
+    /**
+     * Returns true if the steal operation needs to be retried.
+     *
+     * ```kotlin
+     * check(!Steal.Empty.isRetry())
+     * check(!Steal.Success(7).isRetry())
+     * check(Steal.Retry.isRetry())
+     * ```
+     */
+    public fun isRetry(): Boolean = this === Retry
+
+    /**
+     * Returns the result of the operation, if successful, otherwise null.
+     * Successful task values are non-null, so null always means that no task was stolen.
+     *
+     * ```kotlin
+     * check(Steal.Empty.success() == null)
+     * check(Steal.Retry.success() == null)
+     * check(Steal.Success(7).success() == 7)
+     * ```
+     */
+    public fun success(): T? =
+        when (this) {
+            is Success -> value
+            Empty, Retry -> null
+        }
+
+    /**
+     * If no task was stolen, attempts another steal operation.
+     *
+     * Returns this result if it is [Success]. Otherwise invokes [f]: a second success is
+     * returned, any retry in either unsuccessful result produces [Retry], and two empty
+     * results produce [Empty].
+     *
+     * ```kotlin
+     * val retry: Steal<Int> = Steal.Retry
+     * val empty: Steal<Int> = Steal.Empty
+     * check(Steal.Success(1).orElse { Steal.Success(2) } == Steal.Success(1))
+     * check(retry.orElse { Steal.Success(2) } == Steal.Success(2))
+     * check(retry.orElse { Steal.Empty } == Steal.Retry)
+     * check(empty.orElse { Steal.Retry } == Steal.Retry)
+     * check(empty.orElse { Steal.Empty } == Steal.Empty)
+     * ```
+     */
+    public fun orElse(f: () -> Steal<@UnsafeVariance T>): Steal<T> =
+        when (this) {
+            Empty -> f()
+            is Success -> this
+            Retry ->
+                when (val second = f()) {
+                    is Success -> second
+                    Empty, Retry -> Retry
+                }
+        }
+
+    public companion object {
+        /**
+         * Consumes items until a [Success] is found and returns it.
+         * If none succeeds but at least one retries, returns [Retry]; otherwise returns [Empty].
+         */
+        public fun <T : Any> fromIter(iter: Iterable<Steal<T>>): Steal<T> {
+            var retry = false
+            for (result in iter) {
+                when (result) {
+                    Empty -> Unit
+                    is Success -> return result
+                    Retry -> retry = true
+                }
+            }
+            return if (retry) Retry else Empty
+        }
+    }
+}
