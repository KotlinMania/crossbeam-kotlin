+/** A block in a linked list. Each block holds up to BLOCK_CAP values. */
+private class Block<T : Any> {
+    // The next block in the linked list.
+    val next = AtomicReference<Block<T>?>(null)
+
+    // Slots for values. Kotlin construction replaces Rust's zeroed raw allocation and Layout.
+    val slots = Array(BLOCK_CAP) { Slot<T>() }
+
+    /** Waits until the next pointer is set. */
+    fun waitNext(): Block<T> {
+        val backoff = Backoff()
+        while (true) {
+            val next = next.load()
+            if (next != null) return next
+            backoff.snooze()
+        }
+    }
+
+    companion object {
+        /** Sets DESTROY in slots preceding count and hands reclamation to their readers. */
+        fun <T : Any> destroy(block: Block<T>, count: Int) {
+            // The last slot has already begun destruction, so its DESTROY bit is unnecessary.
+            for (i in count - 1 downTo 0) {
+                val slot = block.slots[i]
+                // Mark DESTROY if a thread is still using the slot. That reader continues
+                // destruction after it has finished reading its claimed range.
+                if (slot.state.load() and READ == 0 && slot.state.fetchOr(DESTROY) and READ == 0) {
+                    return
+                }
+            }
+            // No thread is using the block. Rust frees its allocation here; Kotlin GC reclaims
+            // it after the last reference disappears. Do not sever next: stale readers may use it.
+        }
+    }
