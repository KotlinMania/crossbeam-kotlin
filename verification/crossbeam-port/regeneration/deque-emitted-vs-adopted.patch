+/** A slot in a block. */
+private class Slot<T : Any> {
+    // The non-null task, or null while its slot is uninitialized or consumed.
+    val task = AtomicReference<Entry<T>?>(null)
+
+    // The state of the slot.
+    val state = AtomicInt(0)
+
+    /** Waits until a task is written into the slot. */
+    fun waitWrite() {
+        val backoff = Backoff()
+        while (state.load() and WRITE == 0) backoff.snooze()
+    }
+
+    // Called only by the thread that successfully claimed this slot through the head CAS.
+    // Clearing the reference is Kotlin's ownership transfer, avoiding retention until block GC.
+    fun takeEntry(): Entry<T> = checkNotNull(task.exchange(null))
+}
