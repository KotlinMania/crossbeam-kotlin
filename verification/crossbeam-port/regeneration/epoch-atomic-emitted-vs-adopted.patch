+private fun validateRmw(order: Ordering) {
+    check(order in Ordering.entries)
+}
+private fun validateCompare(success: Ordering, failure: Ordering) {
+    require(failure != Ordering.Release && failure != Ordering.AcqRel) { "Invalid compare/exchange failure ordering" }
+    require(
+        when (failure) {
+            Ordering.SeqCst -> success == Ordering.SeqCst
+            Ordering.Acquire -> success == Ordering.Acquire || success == Ordering.AcqRel || success == Ordering.SeqCst
+            else -> true
+        },
+    ) { "Failure ordering is stronger than success ordering" }
+}
