+/** Inner state of a wait group. */
+private class Inner {
+    val monitor = createMonitor()
+    val count = AtomicLong(1L)
+
+    // Unlike participant count, Arc ownership includes already-waiting handles.
+    // This prevents destroying the mutex/condvar while a waiter is waking up.
+    val references = AtomicLong(1L)
+
+    fun release() {
+        if (references.fetchAndAdd(-1L) == 1L) monitor.close()
+    }
+}
